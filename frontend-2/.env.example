# ---------------------------------------------------------------------------
# RepoVeriX frontend-2 environment
# Copy to .env.local. Nothing here is required for local development.
# ---------------------------------------------------------------------------

# Server-side proxy target for /api/v1/* (see next.config.mjs).
# The browser only ever talks to this app's own origin, so no backend CORS
# configuration is needed while this is set.
API_ORIGIN=http://localhost:8000

# Public origin of this app. Used for canonical URLs, sitemap, robots and
# Open Graph metadata on public pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# OPTIONAL — bypass the proxy and call the backend directly from the browser.
# Only set this if the backend's REPOVERIX_CORS_ORIGINS includes this origin.
# When empty (default) every request is routed through /api/v1 on this origin.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# OPTIONAL — absolute backend origin used for full-page OAuth redirects
# (browser navigation, so CORS does not apply). Defaults to http://localhost:8000.
# NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
