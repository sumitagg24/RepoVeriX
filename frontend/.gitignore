# Dependencies
node_modules/

# Build output
.next/
# Isolated production build used by playwright.config.ts (NEXT_DIST_DIR) —
# without this entry `npm run test:e2e` leaves ~275MB of untracked build output.
.next-e2e/
out/

# Playwright artifacts
test-results/
playwright-report/

# TypeScript
*.tsbuildinfo

# Design audit output
audit-output/

# Python byte-cache from the ui-ux-pro-max skill scripts
__pycache__/
*.py[cod]

# Keep .mcp.json local overrides (if any) but track the committed version
# .mcp/settings.local.json
.vercel
.env*

# Agent configurations and skills
.agents/
.opencode/
.cursor/
.claude/
