# RepoVeriX frontend-2 — environment
#
# Nothing here is required for a local run. Copy to `.env.local` only when the
# defaults do not match your setup.

# Backend origin the same-origin proxy forwards to. The browser itself only ever
# calls this app, so no CORS change is needed on the API.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Public origin used for canonical URLs, sitemap entries and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: talk to the API directly instead of through the proxy. Set this only
# when the backend already allows this origin through CORS.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# OAuth (Google, GitHub, GitLab, Microsoft, Bitbucket)
#
# OAuth apps are registered against the **backend** origin, and the client
# ID/secret live only in the API's environment — never in this frontend. The
# buttons read `/api/v1/auth/oauth/providers` at runtime and a provider appears
# live as soon as the API has credentials for it.
#
# Backend variables (Render dashboard → Environment):
#   REPOVERIX_GOOGLE_OAUTH_CLIENT_ID / REPOVERIX_GOOGLE_OAUTH_CLIENT_SECRET
#   REPOVERIX_GITHUB_OAUTH_CLIENT_ID / REPOVERIX_GITHUB_OAUTH_CLIENT_SECRET
#   REPOVERIX_BACKEND_PUBLIC_URL=https://<api-host>
#   REPOVERIX_FRONTEND_URL=https://<app-host>
#
# Registered redirect URI, character for character:
#   https://<api-host>/api/v1/auth/oauth/google/callback
#   https://<api-host>/api/v1/auth/oauth/github/callback
