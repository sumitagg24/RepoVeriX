# RepoVeriX Frontend Environment Configuration
# Copy this file to .env.local and fill in the values

# ===========================================
# API Configuration
# ===========================================
# Backend API origin — the axios client appends /api/v1 itself.
# Production example: https://api.repoverix.com  (PUBLIC — never a secret)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# Optional: Analytics/Monitoring
# ===========================================
# Google Analytics ID
# NEXT_PUBLIC_GA_ID=

# Sentry DSN for frontend error tracking
# NEXT_PUBLIC_SENTRY_DSN=