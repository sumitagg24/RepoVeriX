# RepoVeriX frontend-2 — environment
#
# Nothing here is required for a local run. Copy to `.env.local` only when the
# defaults do not match your setup.

# Backend origin the same-origin proxy forwards to. The browser itself only ever
# calls this app, so no CORS change is needed on the API.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Public origin used for canonical URLs, sitemap entries and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: talk to the API directly instead of through the proxy. Set this only
# when the backend already allows this origin through CORS.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth0 — client-side login via @auth0/auth0-react.
# Create a Single Page Application in your Auth0 tenant and set:
#   Application Origin: http://localhost:3001
#   Allowed Callback URLs: http://localhost:3001/auth/callback
#   Allowed Logout URLs: http://localhost:3001
# Then copy this file to `.env.local` and fill in the values from your app.
NEXT_PUBLIC_AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
NEXT_PUBLIC_AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
NEXT_PUBLIC_AUTH0_CALLBACK_URL=http://localhost:3001/auth/callback
