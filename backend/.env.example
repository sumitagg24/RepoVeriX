# Copy to .env and adjust. All variables are prefixed with REPOVERIX_.
REPOVERIX_DEBUG=false
REPOVERIX_DATABASE_URL=postgresql+asyncpg://repoverix:repoverix@localhost:5432/repoverix
REPOVERIX_AUTO_CREATE_TABLES=true
REPOVERIX_JWT_SECRET=change-me-in-production
REPOVERIX_ACCESS_TOKEN_EXPIRE_MINUTES=1440
REPOVERIX_CORS_ORIGINS=["http://localhost:3000"]

# HTTP hardening: hostnames accepted on the Host header (empty = accept all);
# interactive API docs (/docs, /openapi.json) are off unless enabled here or
# debug=true. Keep both locked down in production.
REPOVERIX_ALLOWED_HOSTS=["localhost", "127.0.0.1"]
REPOVERIX_EXPOSE_API_DOCS=false
REPOVERIX_REPOSITORY_STORAGE_DIR=./data/repositories

# SSRF guard: outbound git clones and archive downloads whose host resolves to
# a private / loopback / link-local / cloud-metadata address are rejected.
# Leave false unless you intentionally import from an internal git server.
REPOVERIX_SSRF_ALLOW_PRIVATE_HOSTS=false

# Encryption at rest for third-party OAuth tokens (Google/GitHub/GitLab).
# Generate a key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be set in production; when unset tokens are stored in plaintext (dev only).
REPOVERIX_TOKEN_ENCRYPTION_KEY=

# Database backups (python scripts/backup.py — schedule via cron/CI):
REPOVERIX_BACKUP_DIR=./data/backups
REPOVERIX_BACKUP_RETENTION_DAYS=14

# LLM provider (Phase 5). Keys are never passed into sandboxed repositories.
REPOVERIX_LLM_PROVIDER=openai
REPOVERIX_LLM_MODEL=gpt-4o-mini
REPOVERIX_OPENAI_API_KEY=
REPOVERIX_ANTHROPIC_API_KEY=

# Sandbox limits (Phase 9): CPU, memory, runtime, and max processes a
# verification container may spawn (fork-bomb guard).
REPOVERIX_SANDBOX_CPU_LIMIT=1.0
REPOVERIX_SANDBOX_MEMORY_LIMIT=1g
REPOVERIX_SANDBOX_TIMEOUT_SECONDS=600
REPOVERIX_SANDBOX_PIDS_LIMIT=256
