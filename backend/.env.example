# Copy to .env and adjust. All variables are prefixed with REPOVERIX_.
REPOVERIX_DEBUG=false
REPOVERIX_DATABASE_URL=postgresql+asyncpg://repoverix:repoverix@localhost:5432/repoverix
REPOVERIX_AUTO_CREATE_TABLES=true
REPOVERIX_JWT_SECRET=change-me-in-production
REPOVERIX_ACCESS_TOKEN_EXPIRE_MINUTES=1440
REPOVERIX_CORS_ORIGINS=["http://localhost:3000"]

# HTTP hardening: hostnames accepted on the Host header (empty = accept all);
# interactive API docs (/docs, /openapi.json) are off unless enabled here or
# debug=true. Keep both locked down in production.
REPOVERIX_ALLOWED_HOSTS=["localhost", "127.0.0.1"]
REPOVERIX_EXPOSE_API_DOCS=false
REPOVERIX_REPOSITORY_STORAGE_DIR=./data/repositories

# SSRF guard: outbound git clones and archive downloads whose host resolves to
# a private / loopback / link-local / cloud-metadata address are rejected.
# Leave false unless you intentionally import from an internal git server.
REPOVERIX_SSRF_ALLOW_PRIVATE_HOSTS=false

# Encryption at rest for third-party OAuth tokens (Google/GitHub/GitLab/Auth0/Oracle).
# Generate a key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be set in production; when unset tokens are stored in plaintext (dev only).
REPOVERIX_TOKEN_ENCRYPTION_KEY=

# Auth0 sign-in provider (see docs/auth0.md).
# Tenant domain: the ``<tenant>.auth0.com`` value from your Auth0 dashboard,
# without the protocol (e.g. repoverix.us.auth0.com).
REPOVERIX_AUTH0_DOMAIN=
REPOVERIX_AUTH0_OAUTH_CLIENT_ID=
REPOVERIX_AUTH0_OAUTH_CLIENT_SECRET=

# Dodo Payments (merchant of record: hosted checkout + customer portal).
# Get your API key from the Dodo dashboard. Without it, paid flows degrade
# to demo mode (REPOVERIX_BILLING_DEMO_MODE=true) and nothing below is used.
REPOVERIX_DODO_API_KEY=
# Webhook signing secret (whsec_…) from your Dodo webhook endpoint config.
# Used to verify Standard Webhooks signatures on POST /api/v1/billing/webhook.
REPOVERIX_DODO_WEBHOOK_SECRET=
# Product IDs of the recurring Pro / Team subscriptions. Create them once with
# backend/scripts/setup_dodo_products.py and paste the IDs here.
REPOVERIX_DODO_PRODUCT_ID_PRO=
REPOVERIX_DODO_PRODUCT_ID_TEAM=
# test_mode -> test.dodopayments.com ; live_mode -> live.dodopayments.com
REPOVERIX_DODO_ENVIRONMENT=test_mode
# Operator accounts: comma-separated emails that bypass every plan gate
# (quotas, premium tools and LLM-only scan configurations) and are reported
# with the "admin" plan. Computed per request — never stored — so removing an
# email here revokes the access immediately. The deployment owner's addresses
# are always granted (OWNER_EMAILS in app/services/billing.py).
REPOVERIX_ADMIN_EMAILS=

# Database backups (python scripts/backup.py — schedule via cron/CI):
REPOVERIX_BACKUP_DIR=./data/backups
REPOVERIX_BACKUP_RETENTION_DAYS=14

# LLM provider (Phase 5). Keys are never passed into sandboxed repositories.
# provider: openai | anthropic | gemini | openrouter | nvidia | mock
REPOVERIX_LLM_PROVIDER=openai
REPOVERIX_LLM_MODEL=gpt-4o-mini
REPOVERIX_OPENAI_API_KEY=
REPOVERIX_ANTHROPIC_API_KEY=
# OpenAI-compatible gateways (provider=openrouter | nvidia). Model ids are
# gateway-specific; REPOVERIX_LLM_MODEL overrides the built-in defaults.
# Any extra configured key becomes an automatic fallback: the first provider
# that answers wins (e.g. nvidia primary + openrouter backup survives either
# gateway being down). A scan report names the provider that actually answered.
REPOVERIX_OPENROUTER_API_KEY=
REPOVERIX_NVIDIA_API_KEY=
# Optional explicit fallback order, comma-separated (empty = automatic).
REPOVERIX_LLM_FALLBACK_PROVIDERS=

# Sandbox limits (Phase 9): CPU, memory, runtime, and max processes a
# verification container may spawn (fork-bomb guard).
REPOVERIX_SANDBOX_CPU_LIMIT=1.0
REPOVERIX_SANDBOX_MEMORY_LIMIT=1g
REPOVERIX_SANDBOX_TIMEOUT_SECONDS=600
REPOVERIX_SANDBOX_PIDS_LIMIT=256