# RepoVeriX Environment Configuration
# Copy to .env and fill in real values. Never commit secrets.
# Backend settings are read with a REPOVERIX_ prefix (pydantic-settings),
# so every backend variable below is named REPOVERIX_*.

# ===========================================
# Backend — database
# ===========================================
# Async SQLAlchemy URL. PostgreSQL for real use; SQLite works for a quick demo.
REPOVERIX_DATABASE_URL=postgresql+asyncpg://repoverix:repoverix@localhost:5432/repoverix
# REPOVERIX_DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# Create tables on startup (development). Disable when using Alembic migrations.
REPOVERIX_AUTO_CREATE_TABLES=true

# ===========================================
# Backend — auth
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REPOVERIX_JWT_SECRET=change-me-to-a-long-random-string
REPOVERIX_JWT_ALGORITHM=HS256
REPOVERIX_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# Backend — repository storage
# ===========================================
# Where uploaded archives / working copies live (never the repo source).
REPOVERIX_REPOSITORY_STORAGE_DIR=./data/repositories

# Ingestion limits (untrusted content)
REPOVERIX_MAX_REPO_SIZE_MB=100
REPOVERIX_MAX_FILE_SIZE_KB=1024
REPOVERIX_MAX_FILES=5000
REPOVERIX_GIT_CLONE_TIMEOUT_SECONDS=300
# Repository intelligence (code health / git analytics / wiki) bounds.
# Health + wiki are deterministic; git analytics use the retained history.
REPOVERIX_INTEL_MAX_FILES=300
REPOVERIX_INTEL_WIKI_MAX_FILES=120
# How much git history clones retain for hotspots/ownership/co-change.
REPOVERIX_GIT_HISTORY_MONTHS=12
# Uploaded archive payload cap in bytes (streamed to disk, then magic-sniffed).
REPOVERIX_MAX_UPLOAD_BYTES=115343360

# ===========================================
# Backend — rate limiting (all thresholds configurable)
# ===========================================
# Master switch. False disables ALL limits (never do this in production;
# the automated test-suite runs with it off for determinism).
REPOVERIX_RATE_LIMIT_ENABLED=true
# Set true only when the API sits behind a reverse proxy that overwrites
# X-Forwarded-For; false when it is directly internet-facing.
REPOVERIX_TRUST_PROXY_HEADERS=false
# Authentication routes (login/signup): attempts per window, enforced on BOTH
# the client IP and the account email. Exceeding the budget triggers an
# exponential backoff starting at BASE and doubling per repeat, capped at MAX.
REPOVERIX_AUTH_RATE_LIMIT_ATTEMPTS=8
REPOVERIX_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
REPOVERIX_AUTH_BACKOFF_BASE_SECONDS=30
REPOVERIX_AUTH_BACKOFF_MAX_SECONDS=3600
# Unauthenticated public endpoints per IP.
REPOVERIX_PUBLIC_RATE_LIMIT_PER_MINUTE=120
# Authenticated users: global budget across API calls.
REPOVERIX_USER_RATE_LIMIT_PER_MINUTE=600
# Expensive actions per user per minute: scan creation, ZIP/archive/OAuth
# imports, LLM fix generation, sandbox verification runs.
REPOVERIX_USER_ACTION_RATE_LIMIT_PER_MINUTE=15

# ===========================================
# Backend — LLM providers (optional)
# ===========================================
# provider: openai | anthropic | gemini | openrouter | nvidia | mock
REPOVERIX_LLM_PROVIDER=openai
REPOVERIX_LLM_MODEL=gpt-4o-mini
REPOVERIX_OPENAI_API_KEY=
# Point the OpenAI client at any OpenAI-compatible endpoint (self-hosted, proxy).
REPOVERIX_OPENAI_BASE_URL=
REPOVERIX_ANTHROPIC_API_KEY=
REPOVERIX_ANTHROPIC_MODEL=claude-3-5-haiku-latest
REPOVERIX_GEMINI_API_KEY=
REPOVERIX_GEMINI_MODEL=gemini-1.5-flash
# OpenRouter (key from https://openrouter.ai/keys) — set
# REPOVERIX_LLM_PROVIDER=openrouter; model ids look like "openai/gpt-4o-mini"
# or "deepseek/deepseek-chat-v3". REPOVERIX_LLM_MODEL overrides the built-in
# default model.
REPOVERIX_OPENROUTER_API_KEY=
REPOVERIX_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA NIM (key from https://build.nvidia.com — starts with nvapi-) — set
# REPOVERIX_LLM_PROVIDER=nvidia; pick a model from the catalog and put its id
# in REPOVERIX_LLM_MODEL.
REPOVERIX_NVIDIA_API_KEY=
REPOVERIX_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Any *extra* configured provider key above becomes an automatic fallback when
# the primary fails (timeout, network error, 4xx/5xx): the first provider that
# answers wins. E.g. REPOVERIX_LLM_PROVIDER=nvidia +
# REPOVERIX_OPENROUTER_API_KEY=... keeps scanning when NVIDIA is down.
# REPOVERIX_LLM_FALLBACK_PROVIDERS pins the order (comma-separated, e.g.
# "openrouter,openai"); empty = automatic (other configured providers).
REPOVERIX_LLM_FALLBACK_PROVIDERS=

# LLM safety / cost controls
REPOVERIX_LLM_TIMEOUT_SECONDS=120
REPOVERIX_LLM_MAX_RETRIES=2
REPOVERIX_LLM_TEMPERATURE=0.0
REPOVERIX_LLM_MAX_CANDIDATES_PER_SCAN=60
REPOVERIX_LLM_MAX_CONTEXT_CHARS=24000

# ===========================================
# Backend — verification sandbox (Docker)
# ===========================================
# Execution of patched repositories ALWAYS happens in Docker with limits.
REPOVERIX_SANDBOX_CPU_LIMIT=1.0
REPOVERIX_SANDBOX_MEMORY_LIMIT=1g
REPOVERIX_SANDBOX_TIMEOUT_SECONDS=600
# "bridge" allows dependency downloads; "none" disables container networking
REPOVERIX_SANDBOX_NETWORK=bridge

# ===========================================
# OAuth sign-in & repository import (Google / GitHub / GitLab)
# ===========================================
# Register an OAuth app per provider and paste the credentials. Google, GitHub
# and GitLab buttons are always shown on the sign-in page; one whose credentials
# are missing shows a Setup badge that explains what to add. URL/ZIP imports
# work without any OAuth app.
#   Google    -> https://console.cloud.google.com/apis/credentials  (OAuth client, Web)
#   GitHub    -> https://github.com/settings/developers
#   GitLab    -> https://gitlab.com/-/user_settings/applications
#   Microsoft -> https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps  (Azure AD App)
#   Bitbucket -> https://bitbucket.org/account/settings/app-passwords/  (OAuth consumer)
#   Auth0     -> https://manage.auth0.com/#/applications  (Regular Web App)
#   Oracle    -> https://cloud.oracle.com/identity/domains  (Oracle Cloud IDCS / IAM)
# Authorized redirect URI for every provider:
#   http://localhost:8000/api/v1/auth/oauth/{provider}/callback
# Absolute URL of the frontend — where the browser lands after OAuth.
REPOVERIX_FRONTEND_URL=http://localhost:3000
# Public origin of the API *as the browser reaches it*. Set this in any
# deployment behind a reverse proxy so the redirect URI above is built with the
# public scheme/host (providers match it character for character). Leave unset
# when the API is reached directly.
# REPOVERIX_BACKEND_PUBLIC_URL=https://api.example.com
# Which social providers may be offered. A provider outside this list is never
# shown even when its credentials are set; an empty list disables all of them.
# REPOVERIX_AUTH_ALLOWED_SOCIAL_PROVIDERS=["google","github","gitlab"]
REPOVERIX_GOOGLE_OAUTH_CLIENT_ID=
REPOVERIX_GOOGLE_OAUTH_CLIENT_SECRET=
REPOVERIX_GITHUB_OAUTH_CLIENT_ID=
REPOVERIX_GITHUB_OAUTH_CLIENT_SECRET=
REPOVERIX_GITLAB_OAUTH_CLIENT_ID=
REPOVERIX_GITLAB_OAUTH_CLIENT_SECRET=
REPOVERIX_MICROSOFT_OAUTH_CLIENT_ID=
REPOVERIX_MICROSOFT_OAUTH_CLIENT_SECRET=
REPOVERIX_BITBUCKET_OAUTH_CLIENT_ID=
REPOVERIX_BITBUCKET_OAUTH_CLIENT_SECRET=
REPOVERIX_AUTH0_DOMAIN=
REPOVERIX_AUTH0_OAUTH_CLIENT_ID=
REPOVERIX_AUTH0_OAUTH_CLIENT_SECRET=
REPOVERIX_ORACLE_IDCS_URL=
REPOVERIX_ORACLE_OAUTH_CLIENT_ID=
REPOVERIX_ORACLE_OAUTH_CLIENT_SECRET=

# ===========================================
# Backend — billing / subscriptions (Dodo Payments)
# ===========================================
# Enforce plan entitlements: over-quota actions return 402 + an upsell reason.
# Set false for a frictionless local demo (tests run with it off).
REPOVERIX_BILLING_ENFORCE=true
# Demo mode simulates successful checkouts instantly — no Dodo Payments
# credentials needed. NEVER ship with demo mode enabled (anyone can grant
# themselves Pro).
REPOVERIX_BILLING_DEMO_MODE=true
# Length of a billing cycle in days (usage counters roll over at period end).
REPOVERIX_BILLING_PERIOD_DAYS=30
# Operator accounts: comma-separated emails that bypass every plan gate
# (quotas, premium tools and LLM-only scan configurations) and are reported
# with the "admin" plan. The grant is computed per request — never stored —
# so removing an email here revokes it immediately. The deployment owner's
# addresses are always granted (OWNER_EMAILS in app/services/billing.py).
REPOVERIX_ADMIN_EMAILS=
# Live Dodo Payments: API key (Bearer token) + webhook signing secret
# (whsec_…) from the webhook endpoint config in the Dodo dashboard.
REPOVERIX_DODO_API_KEY=
REPOVERIX_DODO_WEBHOOK_SECRET=
# Product IDs from your Dodo dashboard for the recurring Pro and Team products.
REPOVERIX_DODO_PRODUCT_ID_PRO=
REPOVERIX_DODO_PRODUCT_ID_TEAM=
# test_mode talks to test.dodopayments.com (test cards); live_mode charges real cards.
REPOVERIX_DODO_ENVIRONMENT=test_mode
# Plan prices/limits live in backend/app/services/billing.py (PLANS table);
# the billing UI and landing page mirror them (Free $0 / Pro $29 / Team $99).

# ===========================================
# Frontend
# ===========================================
# Base URL of the backend WITHOUT the /api/v1 prefix (the app appends it).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Canonical site URL used for sitemap, metadata, and OpenGraph image tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# docker-compose helper values (PostgreSQL container)
# ===========================================
POSTGRES_USER=repoverix
POSTGRES_PASSWORD=repoverix
POSTGRES_DB=repoverix