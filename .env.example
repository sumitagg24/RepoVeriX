# RepoVeriX Environment Configuration
# Copy to .env and fill in real values. Never commit secrets.
# Backend settings are read with a REPOVERIX_ prefix (pydantic-settings),
# so every backend variable below is named REPOVERIX_*.

# ===========================================
# Backend — database
# ===========================================
# Async SQLAlchemy URL. PostgreSQL for real use; SQLite works for a quick demo.
REPOVERIX_DATABASE_URL=postgresql+asyncpg://repoverix:repoverix@localhost:5432/repoverix
# REPOVERIX_DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# Create tables on startup (development). Disable when using Alembic migrations.
REPOVERIX_AUTO_CREATE_TABLES=true

# ===========================================
# Backend — auth
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REPOVERIX_JWT_SECRET=change-me-to-a-long-random-string
REPOVERIX_JWT_ALGORITHM=HS256
REPOVERIX_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# Backend — repository storage
# ===========================================
# Where uploaded archives / working copies live (never the repo source).
REPOVERIX_REPOSITORY_STORAGE_DIR=./data/repositories

# Ingestion limits (untrusted content)
REPOVERIX_MAX_REPO_SIZE_MB=100
REPOVERIX_MAX_FILE_SIZE_KB=1024
REPOVERIX_MAX_FILES=5000
REPOVERIX_GIT_CLONE_TIMEOUT_SECONDS=300

# ===========================================
# Backend — LLM providers (optional)
# ===========================================
# provider: openai | anthropic | gemini | mock
REPOVERIX_LLM_PROVIDER=openai
REPOVERIX_LLM_MODEL=gpt-4o-mini
REPOVERIX_OPENAI_API_KEY=
REPOVERIX_OPENAI_BASE_URL=
REPOVERIX_ANTHROPIC_API_KEY=
REPOVERIX_ANTHROPIC_MODEL=claude-3-5-haiku-latest
REPOVERIX_GEMINI_API_KEY=
REPOVERIX_GEMINI_MODEL=gemini-1.5-flash

# LLM safety / cost controls
REPOVERIX_LLM_TIMEOUT_SECONDS=120
REPOVERIX_LLM_MAX_RETRIES=2
REPOVERIX_LLM_TEMPERATURE=0.0
REPOVERIX_LLM_MAX_CANDIDATES_PER_SCAN=60
REPOVERIX_LLM_MAX_CONTEXT_CHARS=24000

# ===========================================
# Backend — verification sandbox (Docker)
# ===========================================
# Execution of patched repositories ALWAYS happens in Docker with limits.
REPOVERIX_SANDBOX_CPU_LIMIT=1.0
REPOVERIX_SANDBOX_MEMORY_LIMIT=1g
REPOVERIX_SANDBOX_TIMEOUT_SECONDS=600
# "bridge" allows dependency downloads; "none" disables container networking
REPOVERIX_SANDBOX_NETWORK=bridge

# ===========================================
# Frontend
# ===========================================
# Base URL of the backend WITHOUT the /api/v1 prefix (the app appends it).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# docker-compose helper values (PostgreSQL container)
# ===========================================
POSTGRES_USER=repoverix
POSTGRES_PASSWORD=repoverix
POSTGRES_DB=repoverix
