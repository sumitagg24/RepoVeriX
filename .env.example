# RepoVeriX Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# General
# ===========================================
# JWT secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ===========================================
# Database
# ===========================================
# PostgreSQL connection (used by backend)
POSTGRES_USER=repoverix
POSTGRES_PASSWORD=repoverix
POSTGRES_DB=repoverix

# ===========================================
# LLM Providers (Optional - for Phase 5+)
# ===========================================
# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ===========================================
# Frontend
# ===========================================
# Backend API URL (used by frontend for server-side calls)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ===========================================
# Sandbox/Verification (Phase 9+)
# ===========================================
# Docker socket access for sandboxed verification (requires privileged)
# DOCKER_HOST=unix:///var/run/docker.sock

# ===========================================
# Monitoring (Optional)
# ===========================================
# Sentry DSN for error tracking
# SENTRY_DSN=

# ===========================================
# Email (Optional - for notifications)
# ===========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@repoverix.com