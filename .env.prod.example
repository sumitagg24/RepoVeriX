# RepoVeriX — production environment matrix (VPS stack)
#
# Copy to .env on the server and fill in real values. NEVER commit .env.
# Classification:
#   PUBLIC  — safe to expose to browsers / build systems (not secret).
#   SECRET  — never expose client-side, never commit, rotate if leaked.

# ---------------------------------------------------------------- required ---
# SECRET — Neon pooled connection string for the backend (asyncpg dialect).
#   Format: postgresql+asyncpg://<user>:<password>@<host>/<db>?ssl=require
#   Get it from the Neon console (pooled connection, sslmode=require).
REPOVERIX_DATABASE_URL=

# SECRET — JWT signing key. Generate: python -c "import secrets; print(secrets.token_hex(32))"
REPOVERIX_JWT_SECRET=

# PUBLIC — browser origins allowed by backend CORS (JSON list).
#   The deployed frontend origin; add any preview origins you need.
REPOVERIX_CORS_ORIGINS=["https://repoverix.vercel.app"]

# PUBLIC — Host headers the backend accepts (anti DNS-rebinding).
REPOVERIX_ALLOWED_HOSTS=["api.repoverix.com"]

# PUBLIC — the domain Caddy terminates TLS for.
API_DOMAIN=api.repoverix.com

# PUBLIC — ACME account email for Let's Encrypt certificates.
ACME_EMAIL=

# ------------------------------------------------------------- recommended ---
# SECRET — set true in production so unknown Host headers are rejected with 403.
#   (Code default is enabled; this variable is informational/override.)
REPOVERIX_RATE_LIMIT_ENABLED=true

# PUBLIC — temporary operator decision: with no SMTP configured, the email-
#   verification gate is disabled so signup flows work end to end. Re-enable
#   once REPOVERIX_EMAIL_BACKEND=smtp is configured with real credentials.
REPOVERIX_AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --------------------------------------------------------------- email -------
# PUBLIC — 'console' (dev only, prints links to logs) or 'smtp'.
REPOVERIX_EMAIL_BACKEND=console
# PUBLIC — SMTP relay host/port/from.
REPOVERIX_SMTP_HOST=
REPOVERIX_SMTP_PORT=587
REPOVERIX_SMTP_USER=
# SECRET
REPOVERIX_SMTP_PASSWORD=
REPOVERIX_SMTP_FROM=

# --------------------------------------------------------- LLM providers -----
# Optional — RepoVeriX runs static/evidence analysis without any LLM key.
# PUBLIC — which provider to use when keys are present.
REPOVERIX_LLM_PROVIDER=openai
# SECRET
REPOVERIX_OPENAI_API_KEY=
# SECRET
REPOVERIX_ANTHROPIC_API_KEY=
# SECRET
REPOVERIX_GEMINI_API_KEY=

# ------------------------------------------------------ sandbox limits -------
# PUBLIC — Proof-of-Fix Docker sandbox resource caps.
REPOVERIX_SANDBOX_CPU_LIMIT=1.0
REPOVERIX_SANDBOX_MEMORY_LIMIT=1g
REPOVERIX_SANDBOX_TIMEOUT_SECONDS=600

# ------------------------------------------------------ artifact storage -----
# PUBLIC — 'local' (single instance; artifacts under REPOVERIX_REPOSITORY_STORAGE_DIR)
#   or 's3' (any S3-compatible store: AWS S3, Cloudflare R2, MinIO). Fail-closed:
#   selecting 's3' without full credentials refuses to start rather than
#   silently falling back to local disk.
REPOVERIX_ARTIFACT_STORAGE=local
# PUBLIC — bucket name and (for R2/MinIO) the path-style endpoint.
REPOVERIX_ARTIFACT_S3_BUCKET=
REPOVERIX_ARTIFACT_S3_ENDPOINT=
REPOVERIX_ARTIFACT_S3_REGION=auto
# PUBLIC — key prefix applied to every object (tenant separation).
REPOVERIX_ARTIFACT_S3_PREFIX=artifacts
# SECRET
REPOVERIX_ARTIFACT_S3_ACCESS_KEY=
# SECRET
REPOVERIX_ARTIFACT_S3_SECRET_KEY=
